{
  "name": "fitcheck",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "PORT=${PORT:-5110} NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 node scripts/build.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/db/database.types.ts",
    "env:local": "node scripts/env-local.mjs",
    "seed": "node scripts/seed.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "openai": "7.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
